{
  "name": "eco-reset-web",
  "version": "1.1.0",
  "private": true,
  "description": "Sitio web de Eco Reset — fertilizante foliar orgánico de 1000 ml hecho con residuos alimentarios. Landing + experiencia Scan & Care.",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --format=iife --outfile=assets/js/app.js --target=es2020 && esbuild src/scenes-entry.js --bundle --minify --format=iife --outfile=assets/js/three.bundle.js --alias:three=./assets/vendor/three/three.module.js --target=es2020",
    "dev": "esbuild src/app.js --bundle --format=iife --outfile=assets/js/app.js --target=es2020 --watch",
    "dev:3d": "esbuild src/scenes-entry.js --bundle --format=iife --outfile=assets/js/three.bundle.js --alias:three=./assets/vendor/three/three.module.js --target=es2020 --watch",
    "serve": "python -m http.server 8123"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
